* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=lf
*.md text eol=lf
*.png binary
*.ttf binary
*.wav binary
# Preserve whitespace emitted by Unity and supplied third-party assets.
*.meta -whitespace
*.asset -whitespace
"Game/Assets/TextMesh Pro/**" -whitespace
Game/Assets/FontLicenses/** -whitespace

# Unity serializations may contain engine-generated trailing spaces.
*.prefab -whitespace
*.unity -whitespace
*.mat -whitespace
# chapter.json stores the SHA-256 of these exact bytes (CRLF); normalising would fail the provenance test.
dialogue/Chuong_1_Ban_Duyet.md -text
