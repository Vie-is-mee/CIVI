# Normalize source files across Windows and Linux while keeping Unity GUIDs stable.
* text=auto

# Launchers need CRLF on Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source and Unity serialized assets use LF.
*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.meta text eol=lf -whitespace
*.asset text eol=lf -whitespace
*.unity text eol=lf -whitespace
*.mat text eol=lf -whitespace
*.shader text eol=lf -whitespace
*.hlsl text eol=lf -whitespace

# Approved dialogue and archived planning text use Markdown hard line breaks.
dialogue/*.md -whitespace
docs/history/*.md -whitespace
STORY.md -whitespace

# Binary resources must not be rewritten by Git.
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.wav binary
*.ogg binary
*.zip binary
