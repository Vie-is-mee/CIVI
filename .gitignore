*.booproj

# Unity source is intentionally versioned:
# Game/Assets/** (including .meta), Game/Packages/**, Game/ProjectSettings/**

# Local release builds and disposable backup / QA artifacts
/release/
/Game/release/
/artifacts/
*.log
*.tmp
*.bak

# Python development state
**/__pycache__/
*.py[cod]
**/.pytest_cache/
.venv/
venv/

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Credentials, private keys and local environment configuration
.env
.env.*
!.env.example
!.env.template
*.pem
*.pfx
*.p12
*.key
*.keystore
*.jks
*.mobileprovision
credentials.json
service-account*.json

# Packaged downloads; store playable builds separately as release artifacts
*.zip
*.7z
*.rar

# Unity autosaved recovery scene, not a project source scene
/Game/Assets/_Recovery/
/Game/Assets/_Recovery.meta
